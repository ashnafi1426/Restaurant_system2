{
  "info": {
    "name": "Restaurant System - Waiter Backend Complete Collection",
    "description": "Complete testing collection for all waiter-related API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Waiter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('WAITER_TOKEN', jsonData.token);",
                  "    pm.environment.set('WAITER_ID', jsonData.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"waiter1@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "login"]
            }
          }
        }
      ]
    },
