        {
          "name": "Get Recent Assignments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has data array', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data).to.be.an('array');",
                  "});",
                  "if (pm.response.json().data.length > 0) {",
                  "  var firstTask = pm.response.json().data[0];",
                  "  pm.test('First task has required fields', function() {",
                  "    pm.expect(firstTask).to.have.property('id');",
                  "    pm.expect(firstTask).to.have.property('status');",
                  "    pm.expect(firstTask).to.have.property('room_number');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{WAITER_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/waiter/dashboard/recent-assignments?limit=10",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "waiter", "dashboard", "recent-assignments"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
