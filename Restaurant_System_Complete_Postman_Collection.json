              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_token\": \"{{qr_token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/qr/resolve", "host": ["{{base_url}}"], "path": ["qr", "resolve"] }
          }
        },
        {
          "name": "Validate QR Token Status",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{qr_token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/qr/validate", "host": ["{{base_url}}"], "path": ["qr", "validate"] }
          }
        },
        {
          "name": "Get Public Menu Categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/guest/categories", "host": ["{{base_url}}"], "path": ["guest", "categories"] }
          }
        },
        {
          "name": "Get Menu Items for Guest",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/guest/menu/items", "host": ["{{base_url}}"], "path": ["guest", "menu", "items"] }
          }
        },
        {
          "name": "Create Guest Order (Unified)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('order_id', res.data.id);",
                  "    console.log('Created order_id:', res.data.id);",
                  "} else if (res.id) {",
                  "    pm.collectionVariables.set('order_id', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_token\": \"{{qr_token}}\",\n  \"guest_name\": \"Guest Customer\",\n  \"guest_phone\": \"+251911223344\",\n  \"order_type\": \"dine_in\",\n  \"items\": [\n    {\n      \"menu_item_id\": {{menu_item_id}},\n      \"quantity\": 2,\n      \"special_instructions\": \"Well cooked\"\n    }\n  ],\n  \"payment_type\": \"cash\"\n}"
            },
            "url": { "raw": "{{base_url}}/guest/unified-orders", "host": ["{{base_url}}"], "path": ["guest", "unified-orders"] }
          }
        },
        {
          "name": "Check Realtime Order Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/guest/orders/{{order_id}}/realtime-status",
              "host": ["{{base_url}}"],
              "path": ["guest", "orders", "{{order_id}}", "realtime-status"]
            }
          }
        }
      ]
    },
