    {
      "name": "05. Cashier, Billing & Chapa Payments",
      "item": [
        {
          "name": "Cashier Active Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": { "raw": "{{base_url}}/cashier/dashboard/orders", "host": ["{{base_url}}"], "path": ["cashier", "dashboard", "orders"] }
          }
        },
        {
          "name": "Initialize Online Payment (Chapa)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.tx_ref || (res.data && res.data.tx_ref)) {",
                  "    const tx = res.tx_ref || res.data.tx_ref;",
                  "    pm.collectionVariables.set('tx_ref', tx);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 350.00,\n  \"currency\": \"ETB\",\n  \"email\": \"guest@example.com\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"order_id\": \"{{order_id}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/payments/initialize", "host": ["{{base_url}}"], "path": ["payments", "initialize"] }
          }
        },
        {
          "name": "Verify Payment Transaction",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/payments/verify/{{tx_ref}}",
              "host": ["{{base_url}}"],
              "path": ["payments", "verify", "{{tx_ref}}"]
            }
          }
        },
        {
          "name": "Cashier: Clear & Settle Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/cashier/dashboard/orders/{{order_id}}/clear",
              "host": ["{{base_url}}"],
              "path": ["cashier", "dashboard", "orders", "{{order_id}}", "clear"]
            }
          }
        },
        {
          "name": "Cashier Revenue Report",
